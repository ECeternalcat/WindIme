<?xml version="1.0" encoding="utf-8"?>
<!--
    InputMethod subtype declaration for Garaho T9 IME.
    WindIme handles Chinese / English / Multi-tap / Number modes
    internally via the mode bar, so only a single zh_CN subtype is
    declared for the system input-method selector.
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.garaho.ime.ui.SettingsActivity"
    android:supportsSwitchingToNextInputMethod="true"
    android:supportsInlineSuggestions="false">

    <subtype
        android:label="@string/subtype_zh_CN"
        android:imeSubtypeLocale="zh_CN"
        android:imeSubtypeMode="keyboard" />
</input-method>
