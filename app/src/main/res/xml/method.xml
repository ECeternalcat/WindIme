<?xml version="1.0" encoding="utf-8"?>
<!--
    InputMethod subtype declarations for Garaho T9 IME.
    Doc 1.2: targets Chinese (T9 pinyin) and English (T9 ASCII) modes.
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.garaho.ime.ui.SettingsActivity"
    android:supportsSwitchingToNextInputMethod="true"
    android:supportsInlineSuggestions="false">

    <subtype
        android:label="@string/subtype_zh_CN"
        android:imeSubtypeLocale="zh_CN"
        android:imeSubtypeMode="keyboard"
        android:isDefault="true" />

    <subtype
        android:label="@string/subtype_en_US"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard" />
</input-method>
