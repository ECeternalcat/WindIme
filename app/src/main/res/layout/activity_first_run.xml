<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Brand header bar (consistent with the menu pages). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/brand_primary"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/firstrun_title"
            android:textColor="@color/candidate_focus_text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/firstrun_step_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:textColor="@color/candidate_focus_text"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/brand_accent" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Step 0: Usage notice and disclaimer -->
        <LinearLayout
            android:id="@+id/firstrun_step_notice"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="10dp"
                android:text="@string/wizard_notice_title"
                android:textColor="@color/brand_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="16dp"
                    android:text="@string/wizard_notice_body"
                    android:textColor="@color/primary_text"
                    android:textSize="15sp" />
            </ScrollView>

            <TextView
                android:id="@+id/firstrun_notice_accept"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/list_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:padding="10dp"
                android:text="@string/wizard_notice_accept"
                android:textColor="@color/menu_item_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/wizard_notice_controls"
                android:textColor="@color/primary_text"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Step 1: Welcome -->
        <LinearLayout
            android:id="@+id/firstrun_step_welcome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/firstrun_welcome_title"
                android:textColor="@color/brand_primary"
                android:textSize="34sp"
                android:textStyle="bold"
                android:paddingBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/firstrun_welcome_body"
                android:textColor="@color/primary_text"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Step 2: Set default IME -->
        <LinearLayout
            android:id="@+id/firstrun_step_default"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/firstrun_default_title"
                android:textColor="@color/brand_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingBottom="14dp" />

            <TextView
                android:id="@+id/firstrun_default_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:paddingBottom="20dp" />

            <TextView
                android:id="@+id/firstrun_default_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="48dp"
                android:padding="12dp"
                android:text="@string/firstrun_default_action"
                android:textColor="@color/menu_item_text"
                android:textSize="17sp"
                android:textStyle="bold"
                android:background="@drawable/list_selector"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/firstrun_default_continue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="48dp"
                android:padding="12dp"
                android:layout_marginTop="10dp"
                android:text="@string/firstrun_continue"
                android:textColor="@color/menu_item_text"
                android:textSize="17sp"
                android:background="@drawable/list_selector"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Step 3: Key calibration -->
        <LinearLayout
            android:id="@+id/firstrun_step_calibrate"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/firstrun_calibrate_title"
                android:textColor="@color/brand_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingBottom="14dp" />

            <TextView
                android:id="@+id/firstrun_calibrate_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:paddingBottom="20dp" />

            <TextView
                android:id="@+id/firstrun_calibrate_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="48dp"
                android:padding="12dp"
                android:text="@string/firstrun_calibrate_action"
                android:textColor="@color/menu_item_text"
                android:textSize="17sp"
                android:textStyle="bold"
                android:background="@drawable/list_selector"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/firstrun_calibrate_continue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="48dp"
                android:padding="12dp"
                android:layout_marginTop="10dp"
                android:text="@string/firstrun_continue"
                android:textColor="@color/menu_item_text"
                android:textSize="17sp"
                android:background="@drawable/list_selector"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Step 4: Done -->
        <LinearLayout
            android:id="@+id/firstrun_step_done"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/firstrun_done_title"
                android:textColor="@color/brand_primary"
                android:textSize="36sp"
                android:textStyle="bold"
                android:paddingBottom="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/firstrun_done_body"
                android:textColor="@color/primary_text"
                android:textSize="14sp" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
